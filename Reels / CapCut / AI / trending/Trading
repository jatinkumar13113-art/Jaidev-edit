<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Trending AI Prompts | Jaidev Edit</title>

  <meta name="description" content="Trending AI photo & video editing prompts. Viral reels, Instagram, CapCut & cinematic prompts – Jaidev Edit.">

  <style>
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background: linear-gradient(135deg,#020617,#0b1d3a);
      color:#fff;
    }

    header{
      padding:30px 20px;
      text-align:center;
      background: linear-gradient(135deg,#020617,#081a3a);
    }

    header h1{
      margin:0;
      font-size:32px;
    }

    header p{
      margin-top:8px;
      color:#9ecbff;
      font-size:16px;
    }

    nav{
      margin-top:20px;
    }

    nav a{
      color:#38bdf8;
      margin:0 12px;
      text-decoration:none;
      font-weight:bold;
    }

    .container{
      padding:40px 20px;
      max-width:900px;
      margin:auto;
    }

    .post{
      background:rgba(255,255,255,0.05);
      border-radius:16px;
      padding:25px;
      margin-bottom:30px;
      box-shadow:0 0 25px rgba(56,189,248,0.15);
    }

    .post h2{
      margin-top:0;
      color:#38bdf8;
    }

    .prompt-box{
      background:#020617;
      border-radius:12px;
      padding:15px;
      position:relative;
      margin-top:10px;
    }

    .prompt-text{
      white-space:pre-wrap;
      color:#dbeafe;
      font-size:14px;
    }

    .copy-btn{
      position:absolute;
      top:12px;
      right:12px;
      background:#38bdf8;
      color:#020617;
      border:none;
      padding:6px 12px;
      border-radius:6px;
      cursor:pointer;
      font-weight:bold;
      font-size:12px;
    }

    .copy-btn:hover{
      background:#60a5fa;
    }

    footer{
      text-align:center;
      padding:20px;
      color:#94a3b8;
      font-size:14px;
    }
  </style>
</head>

<body>

<header>
  <h1>🔥 Trending Prompts</h1>
  <p>Viral AI Photo & Video Editing Prompts</p>

  <nav>
    <a href="/">Home</a>
    <a href="/instagram/">Instagram</a>
    <a href="/reels/">Reels</a>
    <a href="/capcut/">CapCut</a>
    <a href="/ai/">AI</a>
  </nav>
</header>

<div class="container">

  <!-- POST 1 -->
  <div class="post">
    <h2>🔥 Viral Cinematic Reel Prompt</h2>
    <div class="prompt-box">
      <button class="copy-btn" onclick="copyText('p1')">Copy</button>
      <div class="prompt-text" id="p1">
Ultra-realistic cinematic reel,
dramatic lighting, shallow depth of field,
smooth slow motion,
dark teal & orange color grading,
professional camera look,
8K quality, Instagram viral style
      </div>
    </div>
  </div>

  <!-- POST 2 -->
  <div class="post">
    <h2>⚡ AI Photo Editing Trend</h2>
    <div class="prompt-box">
      <button class="copy-btn" onclick="copyText('p2')">Copy</button>
      <div class="prompt-text" id="p2">
Hyper-real AI portrait,
sharp face details,
cinematic background blur,
soft skin tones,
studio lighting,
Instagram trending photo edit
      </div>
    </div>
  </div>

  <!-- POST 3 -->
  <div class="post">
    <h2>🎬 CapCut Viral Edit Prompt</h2>
    <div class="prompt-box">
      <button class="copy-btn" onclick="copyText('p3')">Copy</button>
      <div class="prompt-text" id="p3">
Fast cuts synced with beat,
smooth zoom transitions,
motion blur effects,
cinematic overlays,
viral Instagram reel style,
high energy edit
      </div>
    </div>
  </div>

</div>

<footer>
  © 2026 Jaidev Edit
</footer>

<script>
  function copyText(id){
    const text = document.getElementById(id).innerText;
    navigator.clipboard.writeText(text);
    alert("Prompt copied!");
  }
</script>

</body>
</html>
